# ========================================================
# Git Ignore Rules for PULSAR-ASM & AI_PROJECT_SEED
# ========================================================

# 1. Heavy Model Weights (>100MB rejected by GitHub)
pulsar_asm/models/
*.safetensors
*.gguf

# 2. Python Cache & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.tmp
*.log
*.obj

# 3. Snapshot Backups
.snapshots/
doc/.ai_stop

# 4. Explicitly KEEP the <5KB Assembly Engine Binaries!
!pulsar_asm/bin/*.bin

